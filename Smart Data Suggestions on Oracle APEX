DECLARE
  l_request        CLOB;
  l_response       CLOB;
  l_gpt_category   VARCHAR2(4000);
  l_category_list  VARCHAR2(32000);
  BEGIN
  -- Step 1: Build list of CATEGORY_NAME from PRODUCT_CATEGORY
  FOR r IN (SELECT DISTINCT CATEGORY_NAME FROM PRODUCT_CATEGORY ORDER BY CATEGORY_NAME) LOOP
    l_category_list := l_category_list || r.CATEGORY_NAME || ', ';
  END LOOP;

    -- Remove trailing comma
  l_category_list := RTRIM(l_category_list, ', ');

  
  -- Step 2: Build GPT JSON request
  apex_json.initialize_clob_output;
  apex_json.open_object;
  apex_json.write('model', 'gpt-3.5-turbo');
  apex_json.open_array('messages');

   apex_json.open_object;
  apex_json.write('role', 'user');
  apex_json.write('content',
    'Given the product name "' || :P25_PRODUCT_NAME || 
    '", select the most relevant category from this list and return just the name: ' 
    || l_category_list
  );
  apex_json.close_object;

  apex_json.close_array;
  apex_json.write('temperature', 0.5);
  apex_json.close_object;

  l_request := apex_json.get_clob_output;
  apex_json.free_output;

    -- Step 3: Set headers
  apex_web_service.g_request_headers(1).name := 'Content-Type';
  apex_web_service.g_request_headers(1).value := 'application/json';

  apex_web_service.g_request_headers(2).name := 'Authorization';
  apex_web_service.g_request_headers(2).value := 'Bearer <YOUR_OPENAI_API_KEY>';

  -- Step 4: Call GPT
  BEGIN
    l_response := apex_web_service.make_rest_request(
      p_url         => 'https://api.openai.com/v1/chat/completions',
      p_http_method => 'POST',
      p_body        => DBMS_LOB.SUBSTR(l_request, 32000, 1)
    );
  EXCEPTION
    WHEN OTHERS THEN
      :P25_GPT_RAW := '❌ GPT Error: ' || SQLERRM;
      :P25_CATEGORY_ID := NULL;
      RETURN;
  END;

-- Step 5: Parse GPT response
  BEGIN
    apex_json.parse(l_response);
    l_gpt_category := TRIM(apex_json.get_varchar2(p_path => 'choices[1].message.content'));
    :P25_GPT_RAW := l_gpt_category;
  EXCEPTION
    WHEN OTHERS THEN
      :P25_GPT_RAW := '❌ GPT Parse Error: ' || SQLERRM;
      :P25_CATEGORY_ID := NULL;
      RETURN;
  END;

    -- Step 6: Match with PRODUCT_CATEGORY table
  BEGIN
    SELECT CATEGORY_ID
    INTO :P25_CATEGORY_ID
    FROM PRODUCT_CATEGORY
    WHERE UPPER(CATEGORY_NAME) = UPPER(l_gpt_category)
    AND ROWNUM = 1;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      :P25_CATEGORY_ID := NULL;
  END;
END;
